# Primary v3 semantic search query embeddings (text-embedding-3-large, 1024d)
# Also used by optional /api/tts endpoint.
# When omitted, /api/search gracefully falls back to BIBLOS_SEARCH_API_URL.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Stage-2 neural reranking over top-40 pericope candidates (rerank-3-lite)
# Optional: when omitted, /api/search returns hybrid dense + BM25 order directly.
# Get your key at: https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Grounded Scripture and patristic commentary summaries via Anthropic native Citations API
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ESV Bible API key (used by /api/esv for /daily readings and audio)
# Get your key at: https://api.esv.org/
NEXT_PUBLIC_ESV_API_KEY=your_esv_api_key_here

# Optional: URL for the v2 FastAPI/BGE fallback backend (see fallback-api/)
# Used automatically when OPENAI_API_KEY is not set or the OpenAI embeddings call fails.
# BIBLOS_SEARCH_API_URL=https://dssjon-biblos-api.hf.space
